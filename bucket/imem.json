    "checkver": {
        "script": "$n = [int](Invoke-RestMethod 'https://desktop-updates.imem.app/current2').win64.stable.released; '{0}.{1}.{2}' -f [int]($n / 1000000), [int](($n % 1000000) / 1000), [int]($n % 1000)",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://imem.app/download/desktop/win64#/ime-setup-x64.exe"
            }
        }
