{
    "version": "7.3.4",
    "description": "A Telegram client with built-in AI, up to 30 accounts, and chat productivity tools.",
    "homepage": "https://imem.app",
    "license": {
        "identifier": "Proprietary",
        "url": "https://imem.app/tos"
    },
    "architecture": {
        "64bit": {
            "url": "https://imem.app/download/desktop/win64#/ime-setup-x64.exe",
            "hash": "dac5c9e54c5fb0bf7c8c9b3b8d93823e55f0ef7fd70332b489ca617959a88518"
        }
    },
    "installer": {
        "file": "ime-setup-x64.exe",
        "args": [
            "/DIR=\"$dir\"",
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-",
            "/NOICONS",
            "/MERGETASKS=\"!desktopicon\""
        ]
    },
    "post_install": "Remove-Item \"$dir\\ime-setup-x64.exe\" -Force",
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART"
        ]
    },
    "bin": "iMe.exe",
    "shortcuts": [
        [
            "iMe.exe",
            "iMe"
        ]
    ],
    "persist": "tdata",
    "checkver": {
        "script": "$n = [int](Invoke-RestMethod 'https://desktop-updates.imem.app/current2').win64.stable.released; '{0}.{1}.{2}' -f [Math]::Floor($n / 1000000), [Math]::Floor(($n % 1000000) / 1000), ($n % 1000)",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://imem.app/download/desktop/win64#/ime-setup-x64.exe"
            }
        }
    }
}
