{
    "version": "26.1023.6123.0",
    "description": "Desktop application for ChatGPT",
    "homepage": "https://chatgpt.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://openai.com/policies/terms-of-use/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://persistent.oaistatic.com/codex-app-prod/releases/26.1023.6123.0/ChatGPT-x64.msix#/dl.zip",
            "hash": "9890e869a0d40fc00f396ce48ba05dc45ccb8bb36d151dcd1a2ff23d270f2e4d"
        },
        "arm64": {
            "url": "https://persistent.oaistatic.com/codex-app-prod/releases/26.1023.6123.0/ChatGPT-arm64.msix#/dl.zip",
            "hash": "60ada29d9c36d1ba26c4a4901e8c3e8a931ad3c83fe639c7532697e13f67c062"
        }
    },
    "extract_dir": "app",
    "bin": [
        [
            "clean-cache.ps1",
            "chatgpt-clean"
        ]
    ],
    "pre_install": [
        "# 1. 解码 MSIX 原始 URL 编码路径",
        "Get-ChildItem -LiteralPath $dir -Recurse | Sort-Object { $_.FullName.Length } -Descending | ForEach-Object {",
        "    $decodedName = [uri]::UnescapeDataString($_.Name)",
        "    if ($decodedName -ne $_.Name) {",
        "        Rename-Item -LiteralPath $_.FullName -NewName $decodedName",
        "    }",
        "}",
        "# 2. 生成多目录全量缓存清理脚本",
        "$cleanLines = @(",
        "    'Get-Process | Where-Object { $_.ProcessName -match \"^(ChatGPT|codex|crashpad_handler|opencodex)$\" -or ($_.ProcessName -eq \"node\" -and $_.CommandLine -match \"opencodex\") } | Stop-Process -Force -ErrorAction SilentlyContinue',",
        "    '$cacheSubDirs = @(\"Cache\", \"Code Cache\", \"GPUCache\", \"DawnCache\", \"Network\\Cache\", \"Service Worker\\CacheStorage\", \"Service Worker\\ScriptCache\", \"logs\", \"log\")',",
        "    '$scanRoots = @(',",
        "    '    \"$env:APPDATA\\ChatGPT\", \"$env:APPDATA\\Codex\",',",
        "    '    \"$env:LOCALAPPDATA\\ChatGPT\", \"$env:LOCALAPPDATA\\Codex\", \"$env:LOCALAPPDATA\\OpenAI\",',",
        "    '    \"$env:USERPROFILE\\.codex\"',",
        "    ')',",
        "    '$total = 0',",
        "    'foreach ($root in $scanRoots) {',",
        "    '    foreach ($sub in $cacheSubDirs) {',",
        "    '        $p = Join-Path $root $sub',",
        "    '        if (Test-Path -LiteralPath $p) {',",
        "    '            $files = Get-ChildItem -LiteralPath $p -Recurse -File -Force -ErrorAction SilentlyContinue',",
        "    '            $subTotal = ($files | Measure-Object -Property Length -Sum).Sum',",
        "    '            if ($subTotal) { $total += $subTotal }',",
        "    '            Remove-Item -LiteralPath \"$p\\*\" -Recurse -Force -ErrorAction SilentlyContinue',",
        "    '        }',",
        "    '    }',",
        "    '}',",
        "    '$mb = [Math]::Round(($total / 1MB), 2)',",
        "    'Write-Host \"[√] 关联缓存清理完毕，已释放存储空间: $mb MB\" -ForegroundColor Green'",
        ")",
        "$cleanLines | Set-Content -LiteralPath \"$dir\\clean-cache.ps1\" -Encoding UTF8"
    ],
    "post_install": [
        "# 1. 精准终止锁定进程（避免 SQLite 独占导致迁移失败）",
        "Get-Process | Where-Object {",
        "    $_.ProcessName -match '^(ChatGPT|codex|crashpad_handler|opencodex)$' -or",
        "    ($_.ProcessName -eq 'node' -and $_.CommandLine -match 'opencodex')",
        "} | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Milliseconds 800",
        "# 2. 注入持久化环境变量（让 Codex 客户端与 CLI 原生引导至 E 盘）",
        "$targetCodexHome = \"$persist_dir\\UserProfile\\.codex\"",
        "[Environment]::SetEnvironmentVariable('CODEX_HOME', $targetCodexHome, 'User')",
        "$env:CODEX_HOME = $targetCodexHome",
        "# 3. 定义全量关联目录映射表",
        "$map = @(",
        "    @{ Type = 'Roaming'; Base = $env:APPDATA; Persist = \"$persist_dir\\AppData\"; Names = @('ChatGPT', 'Codex') },",
        "    @{ Type = 'Local'; Base = $env:LOCALAPPDATA; Persist = \"$persist_dir\\LocalAppData\"; Names = @('Codex', 'OpenAI', 'ChatGPT') },",
        "    @{ Type = 'UserProfile'; Base = $env:USERPROFILE; Persist = \"$persist_dir\\UserProfile\"; Names = @('.codex', '.cache\\codex-runtimes') }",
        ")",
        "# 4. 循环建立持久化连接与数据平移",
        "$legacyDirs = @('Network\\Cache', 'Service Worker\\CacheStorage', 'Service Worker\\ScriptCache', 'Cache', 'Code Cache', 'GPUCache', 'DawnCache')",
        "foreach ($entry in $map) {",
        "    if (!(Test-Path -LiteralPath $entry.Persist)) {",
        "        New-Item -ItemType Directory -Force -Path $entry.Persist | Out-Null",
        "    }",
        "    foreach ($name in $entry.Names) {",
        "        $cPath = Join-Path $entry.Base $name",
        "        $pPath = Join-Path $entry.Persist $name",
        "        if (!(Test-Path -LiteralPath $pPath)) {",
        "            New-Item -ItemType Directory -Force -Path $pPath | Out-Null",
        "        }",
        "        # 确保 C 盘父级目录存在（如 ~/.cache）",
        "        $cParent = Split-Path -Parent $cPath",
        "        if (!(Test-Path -LiteralPath $cParent)) {",
        "            New-Item -ItemType Directory -Force -Path $cParent | Out-Null",
        "        }",
        "        # 拆除 persist 目录内可能残留的历史嵌套死链",
        "        foreach ($sub in $legacyDirs) {",
        "            $subPath = Join-Path $pPath $sub",
        "            $subItem = Get-Item -LiteralPath $subPath -Force -ErrorAction SilentlyContinue",
        "            if ($subItem -and [bool]($subItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "                cmd.exe /c \"rmdir `\"$subPath`\"\" 2>&1 | Out-Null",
        "            }",
        "        }",
        "        # 迁移既有数据并重置 C 盘入口为 Junction",
        "        $item = Get-Item -LiteralPath $cPath -Force -ErrorAction SilentlyContinue",
        "        if ($item) {",
        "            if ([bool]($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "                cmd.exe /c \"rmdir `\"$cPath`\"\" 2>&1 | Out-Null",
        "            } else {",
        "                Copy-Item -Path \"$cPath\\*\" -Destination $pPath -Recurse -Force -ErrorAction SilentlyContinue",
        "                Remove-Item -LiteralPath $cPath -Recurse -Force -ErrorAction SilentlyContinue",
        "            }",
        "        }",
        "        if (Test-Path -LiteralPath $cPath) { cmd.exe /c \"rmdir /S /Q `\"$cPath`\"\" 2>&1 | Out-Null }",
        "        cmd.exe /c \"mklink /J `\"$cPath`\" `\"$pPath`\"\" 2>&1 | Out-Null",
        "    }",
        "}",
        "# 5. 注册 Scoop 别名命令",
        "scoop alias add clean-chatgpt 'chatgpt-clean' 'Clean ChatGPT cache & temp storage' 2>&1 | Out-Null"
    ],
    "pre_uninstall": [
        "# 1. 注销 Scoop 别名与用户环境变量",
        "scoop alias rm clean-chatgpt 2>&1 | Out-Null",
        "[Environment]::SetEnvironmentVariable('CODEX_HOME', $null, 'User')",
        "# 2. 精准终止相关进程",
        "Get-Process | Where-Object {",
        "    $_.ProcessName -match '^(ChatGPT|codex|crashpad_handler|opencodex)$' -or",
        "    ($_.ProcessName -eq 'node' -and $_.CommandLine -match 'opencodex')",
        "} | Stop-Process -Force -ErrorAction SilentlyContinue",
        "# 3. 安全拆除全量 Junction 软链接（不影响 E 盘持久化数据）",
        "$targets = @(",
        "    \"$env:APPDATA\\ChatGPT\", \"$env:APPDATA\\Codex\",",
        "    \"$env:LOCALAPPDATA\\Codex\", \"$env:LOCALAPPDATA\\OpenAI\", \"$env:LOCALAPPDATA\\ChatGPT\",",
        "    \"$env:USERPROFILE\\.codex\", \"$env:USERPROFILE\\.cache\\codex-runtimes\"",
        ")",
        "foreach ($p in $targets) {",
        "    $item = Get-Item -LiteralPath $p -Force -ErrorAction SilentlyContinue",
        "    if ($item -and [bool]($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "        cmd.exe /c \"rmdir `\"$p`\"\" 2>&1 | Out-Null",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "ChatGPT.exe",
            "ChatGPT"
        ]
    ],
    "env_set": {
        "CODEX_CLI_PATH": "$dir\\resources\\codex.exe",
        "CODEX_SPARKLE_ENABLED": "false"
    },
    "checkver": {
        "script": "(Invoke-WebRequest 'https://persistent.oaistatic.com/codex-app-prod/ChatGPT-x64.msix' -Method Head -UseBasicParsing).Headers['x-ms-meta-package_version']",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://persistent.oaistatic.com/codex-app-prod/releases/$version/ChatGPT-x64.msix#/dl.zip"
            },
            "arm64": {
                "url": "https://persistent.oaistatic.com/codex-app-prod/releases/$version/ChatGPT-arm64.msix#/dl.zip"
            }
        }
    }
}
