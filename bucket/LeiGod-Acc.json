{
    "version": "11.3.3.0",
    "description": "雷神加速器 - 游戏网络加速客户端",
    "homepage": "https://www.leigod.com/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://update.leigod.com/soft/leigod/win/11.0.0.0/LeiGodSetup.11.3.3.0.exe#/dl.7z",
            "hash": "e17633f4594c1f59ee62fb31a36e080e946905e8a1dd65d32c3627fa9269044f"
        }
    },
    "extract_to": "installer",
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\installer\\.rdata\" -PathType Leaf)) { throw 'LeiGod payload archive .rdata is missing; the upstream installer layout may have changed.' }",
        "Expand-7zipArchive -Path \"$dir\\installer\\.rdata\" -DestinationPath \"$dir\"",
        "if (-not (Test-Path -LiteralPath \"$dir\\leigod.exe\" -PathType Leaf)) { throw 'LeiGod payload extraction completed, but leigod.exe was not found.' }",
        "Remove-Item -LiteralPath \"$dir\\installer\" -Recurse -Force -ErrorAction Stop",
        "function New-LeiGodPersistJunction {",
        "    param([Parameter(Mandatory = $true)][string]$Source, [Parameter(Mandatory = $true)][string]$Destination)",
        "    if (-not (Test-Path -LiteralPath $Destination -PathType Container)) {",
        "        New-Item -ItemType Directory -Path $Destination -Force -ErrorAction Stop | Out-Null",
        "    }",
        "    if (Test-Path -LiteralPath $Source) {",
        "        $sourceItem = Get-Item -LiteralPath $Source -Force -ErrorAction Stop",
        "        if (($sourceItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { return }",
        "        if (-not $sourceItem.PSIsContainer) { throw \"Refusing to migrate LeiGod data because '$Source' is not a directory.\" }",
        "        $sourceRoot = [System.IO.Path]::GetFullPath($Source).TrimEnd('\\') + '\\'",
        "        $sourceFiles = @(Get-ChildItem -LiteralPath $Source -File -Recurse -Force -ErrorAction Stop)",
        "        foreach ($sourceFile in $sourceFiles) {",
        "            $relativePath = $sourceFile.FullName.Substring($sourceRoot.Length)",
        "            $targetFile = Join-Path $Destination $relativePath",
        "            if (Test-Path -LiteralPath $targetFile) {",
        "                $targetItem = Get-Item -LiteralPath $targetFile -Force -ErrorAction Stop",
        "                if ($targetItem.PSIsContainer) { throw \"Cannot migrate LeiGod data because '$targetFile' is a directory, but a file is expected.\" }",
        "                $sourceHash = (Get-FileHash -LiteralPath $sourceFile.FullName -Algorithm SHA256 -ErrorAction Stop).Hash",
        "                $targetHash = (Get-FileHash -LiteralPath $targetFile -Algorithm SHA256 -ErrorAction Stop).Hash",
        "                if ($sourceHash -ne $targetHash) { throw \"Conflicting LeiGod data found at '$targetFile'. The source directory was kept; resolve the conflict before retrying.\" }",
        "            }",
        "        }",
        "        $sourceDirectories = @(Get-ChildItem -LiteralPath $Source -Directory -Recurse -Force -ErrorAction Stop)",
        "        foreach ($sourceDirectory in $sourceDirectories) {",
        "            $relativeDirectory = $sourceDirectory.FullName.Substring($sourceRoot.Length)",
        "            $targetDirectory = Join-Path $Destination $relativeDirectory",
        "            if (-not (Test-Path -LiteralPath $targetDirectory -PathType Container)) {",
        "                New-Item -ItemType Directory -Path $targetDirectory -Force -ErrorAction Stop | Out-Null",
        "            }",
        "        }",
        "        foreach ($sourceFile in $sourceFiles) {",
        "            $relativePath = $sourceFile.FullName.Substring($sourceRoot.Length)",
        "            $targetFile = Join-Path $Destination $relativePath",
        "            if (-not (Test-Path -LiteralPath $targetFile -PathType Leaf)) {",
        "                $targetParent = Split-Path -Parent $targetFile",
        "                if (-not (Test-Path -LiteralPath $targetParent -PathType Container)) {",
        "                    New-Item -ItemType Directory -Path $targetParent -Force -ErrorAction Stop | Out-Null",
        "                }",
        "                Copy-Item -LiteralPath $sourceFile.FullName -Destination $targetFile -Force -ErrorAction Stop",
        "            }",
        "            $sourceHash = (Get-FileHash -LiteralPath $sourceFile.FullName -Algorithm SHA256 -ErrorAction Stop).Hash",
        "            $targetHash = (Get-FileHash -LiteralPath $targetFile -Algorithm SHA256 -ErrorAction Stop).Hash",
        "            if ($sourceHash -ne $targetHash) { throw \"LeiGod data verification failed for '$targetFile'. The source directory was kept.\" }",
        "        }",
        "        Remove-Item -LiteralPath $Source -Recurse -Force -ErrorAction Stop",
        "    }",
        "    $sourceParent = Split-Path -Parent $Source",
        "    if (-not (Test-Path -LiteralPath $sourceParent -PathType Container)) {",
        "        New-Item -ItemType Directory -Path $sourceParent -Force -ErrorAction Stop | Out-Null",
        "    }",
        "    New-Item -ItemType Junction -Path $Source -Target $Destination -ErrorAction Stop | Out-Null",
        "}",
        "New-LeiGodPersistJunction -Source \"$env:APPDATA\\leigod\" -Destination \"$persist_dir\\APPDATA\"",
        "New-LeiGodPersistJunction -Source \"$env:USERPROFILE\\.leigod\" -Destination \"$persist_dir\\.leigod\""
    ],
    "pre_uninstall": [
        "Get-Process -Name 'leigod' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "function Remove-LeiGodPersistJunction {",
        "    param([Parameter(Mandatory = $true)][string]$Path, [Parameter(Mandatory = $true)][string]$ExpectedTarget)",
        "    if (-not (Test-Path -LiteralPath $Path)) { return }",
        "    $item = Get-Item -LiteralPath $Path -Force -ErrorAction Stop",
        "    if (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq 0) { return }",
        "    $expectedFullPath = [System.IO.Path]::GetFullPath($ExpectedTarget).TrimEnd('\\')",
        "    $targetMatches = $false",
        "    $targetProperty = $item.PSObject.Properties['Target']",
        "    if (($null -ne $targetProperty) -and $targetProperty.Value) {",
        "        try {",
        "            $actualTarget = [System.IO.Path]::GetFullPath([string]$targetProperty.Value).TrimEnd('\\')",
        "            $targetMatches = $actualTarget -ieq $expectedFullPath",
        "        } catch {",
        "            $targetMatches = $false",
        "        }",
        "    }",
        "    if (-not $targetMatches) {",
        "        $fsutilPath = Join-Path $env:SystemRoot 'System32\\fsutil.exe'",
        "        if (Test-Path -LiteralPath $fsutilPath -PathType Leaf) {",
        "            $reparseInfo = (& $fsutilPath reparsepoint query $Path 2>$null | Out-String)",
        "            $targetMatches = -not [string]::IsNullOrWhiteSpace($reparseInfo) -and $reparseInfo.IndexOf($expectedFullPath, [System.StringComparison]::OrdinalIgnoreCase) -ge 0",
        "        }",
        "    }",
        "    if (-not $targetMatches) { return }",
        "    if ($item.PSIsContainer) { [System.IO.Directory]::Delete($Path, $false) } else { [System.IO.File]::Delete($Path) }",
        "}",
        "Remove-LeiGodPersistJunction -Path \"$env:APPDATA\\leigod\" -ExpectedTarget \"$persist_dir\\APPDATA\"",
        "Remove-LeiGodPersistJunction -Path \"$env:USERPROFILE\\.leigod\" -ExpectedTarget \"$persist_dir\\.leigod\""
    ],
    "shortcuts": [
        [
            "leigod.exe",
            "雷神加速器"
        ]
    ],
    "notes": [
        "This manifest extracts the client payload from the official installer instead of running the vendor setup program. If a LeiGod release requires a separate system driver/service installation, that step is not performed by this portable extraction."
    ],
    "checkver": {
        "url": "https://www.leigod.com/configs.json",
        "jsonpath": "$.windows.download_url",
        "regex": "//update\\.leigod\\.com/soft/leigod/win/(?<build>[\\d.]+)/LeiGodSetup\\.(?<ver>[\\d.]+)\\.exe",
        "replace": "${ver}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://update.leigod.com/soft/leigod/win/$matchBuild/LeiGodSetup.$matchVer.exe#/dl.7z",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
