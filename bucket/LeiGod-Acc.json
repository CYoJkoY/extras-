{
    "version": "11.3.3.0",
    "description": "雷神加速器-专线加速游戏，按分钟计费可暂停",
    "homepage": "https://www.leigod.com/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://update.leigod.com/soft/leigod/win/11.0.0.0/LeiGodSetup.11.3.3.0.exe#/dl.7z",
            "hash": "e17633f4594c1f59ee62fb31a36e080e946905e8a1dd65d32c3627fa9269044f"
        }
    },
    "shortcuts": [
        [
            "leigod.exe",
            "雷神加速器"
        ]
    ],
    "extract_to": "installer",
    "pre_install": [
        "Expand-7zipArchive \"$dir\\installer\\.rdata\" \"$dir\"",
        "Remove-Item \"$dir\\installer\" -Recurse -Force -ErrorAction SilentlyContinue | Out-Null",
        "function Link-PersistDir($src, $dst) {",
        "    if (-not (Test-Path $dst)) { New-Item -ItemType Directory -Path $dst -Force | Out-Null }",
        "    if (Test-Path $src) {",
        "        $item = Get-Item $src -Force",
        "        if ($item.Attributes -match 'ReparsePoint') { return }",
        "        Copy-Item -Path \"$src\\*\" -Destination $dst -Recurse -Force -ErrorAction SilentlyContinue",
        "        Remove-Item -Path $src -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "    New-Item -ItemType Junction -Path $src -Target $dst -Force | Out-Null",
        "}",
        "Link-PersistDir \"$env:APPDATA\\leigod\" \"$persist_dir\\APPDATA\"",
        "Link-PersistDir \"$env:USERPROFILE\\.leigod\" \"$persist_dir\\.leigod\""
    ],
    "pre_uninstall": [
        "Stop-Process -Name 'leigod' -Force -ErrorAction SilentlyContinue",
        "@(\"$env:APPDATA\\leigod\", \"$env:USERPROFILE\\.leigod\") | ForEach-Object {",
        "    if (Test-Path $_) {",
        "        $item = Get-Item $_ -Force",
        "        if ($item.Attributes -match 'ReparsePoint') { $item.Delete() }",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://www.leigod.com/configs.json",
        "jsonpath": "$.windows.download_url",
        "regex": "(?<path>.*LeiGodSetup.(.*).exe)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https:$matchPath#/dl.7z"
            }
        }
    }
}
