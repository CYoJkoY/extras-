{
    "version": "0.1.3",
    "description": "A Rust-based Chinese Pinyin input method with translation candidates for language learning.",
    "homepage": "https://qingjian.app",
    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/qingjian-team/qingjian/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/qingjian-team/qingjian/releases/download/windows-v0.1.3/qingjian-0.1.3-windows-x86_64-setup.exe",
            "hash": "257c3b4008b6f8f1aac0666100eab51fa6646e9ae49df51fbce58cbf3eefa52c"
        }
    },
    "installer": {
        "args": [
            "/DIR=\"$dir\"",
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART"
        ]
    },
    "post_install": [
        "$profileTip = '0804:{4FDCA82D-E923-49BF-9E75-BB906B93B8BB}{8119F8E0-CF81-423B-9189-C0D7374324B3}'",
        "",
        "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "",
        "# 1. 确保 zh-CN 中实际启用了青简 TSF Profile。仅添加 zh-CN 不会自动加入第三方输入法。",
        "# 注：icacls / regsvr32 已由 Inno Setup 安装器的 [Run] 段完成（无 skipifsilent，静默下同样执行），这里不再重复。",
        "Write-Host '[1/5] Adding Qingjian to the zh-CN keyboard list...' -ForegroundColor Cyan",
        "$langList = Get-WinUserLanguageList",
        "$zh = $langList | Where-Object { $_.LanguageTag -eq 'zh-CN' } | Select-Object -First 1",
        "if (-not $zh) {",
        " Write-Host ' -> Adding zh-CN language...' -ForegroundColor Yellow",
        " $langList.Add('zh-CN')",
        " $zh = $langList | Where-Object { $_.LanguageTag -eq 'zh-CN' } | Select-Object -First 1",
        "}",
        "",
        "if ($zh.InputMethodTips -notcontains $profileTip) {",
        " $zh.InputMethodTips.Add($profileTip)",
        " Write-Host ' -> Qingjian keyboard profile added' -ForegroundColor Green",
        "} else {",
        " Write-Host ' -> Qingjian keyboard profile already exists' -ForegroundColor Green",
        "}",
        "Set-WinUserLanguageList -LanguageList $langList -Force",
        "",
        "# 2. 刷新 TSF，使语言栏/输入法切换器立即重新读取 profile。",
        "Write-Host '[2/5] Refreshing Windows Text Services...' -ForegroundColor Cyan",
        "Stop-Process -Name ctfmon -Force -ErrorAction SilentlyContinue",
        "Start-Process ctfmon.exe",
        "Start-Sleep -Milliseconds 500",
        "",
        "# 3. 使用当前用户的 Startup 文件夹建立持久登录自启。",
        "# 这与青简官方安装器保持一致：登录时由 Explorer/用户 Shell 启动 Server。",
        "Write-Host '[3/5] Configuring Qingjian login startup...' -ForegroundColor Cyan",
        "$startupDir = [Environment]::GetFolderPath('Startup')",
        "$shortcutPath = Join-Path $startupDir 'Qingjian Server.lnk'",
        "$shell = New-Object -ComObject WScript.Shell",
        "$shortcut = $shell.CreateShortcut($shortcutPath)",
        "$shortcut.TargetPath = \"$dir\\qingjian-server.exe\"",
        "$shortcut.WorkingDirectory = $dir",
        "$shortcut.IconLocation = \"$dir\\qingjian.ico\"",
        "$shortcut.Save()",
        "[void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($shortcut)",
        "[void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($shell)",
        "",
        "# Remove the Run entry created by older versions of this manifest so only one startup mechanism remains.",
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'QingjianServer' -Force -ErrorAction SilentlyContinue",
        "",
        "# 4. 仅为本次安装立即启动一次；之后完全依靠上面的登录自启。",
        "# qingjian-server.exe 的 manifest 带 uiAccess=true：它只能由 ShellExecute（等同双击）在",
        "# 未提升的父进程中拉起，用 CreateProcess / 提升后的进程去起会被拒绝（ERROR_ELEVATION_REQUIRED 740）。",
        "Write-Host '[4/5] Starting Qingjian Server for the current session...' -ForegroundColor Cyan",
        "$server = Join-Path $dir 'qingjian-server.exe'",
        "if (Get-Process -Name 'qingjian-server' -ErrorAction SilentlyContinue) {",
        " Write-Host ' -> Qingjian Server is already running' -ForegroundColor Green",
        "} elseif (-not (Test-Path $server)) {",
        " Write-Host \" -> $server not found\" -ForegroundColor Red",
        "} elseif ($isAdmin) {",
        " Write-Host ' -> Elevated shell: handing the launch back to the user shell (ShellExecute)...' -ForegroundColor Yellow",
        " Start-Process -FilePath 'explorer.exe' -ArgumentList \"`\"$server`\"\"",
        " Start-Sleep -Seconds 3",
        " if (Get-Process -Name 'qingjian-server' -ErrorAction SilentlyContinue) {",
        "  Write-Host ' -> Qingjian Server started' -ForegroundColor Green",
        " } else {",
        "  Write-Host ' -> Refused: 请在未提升权限的 PowerShell 里重装，或手动双击启动' -ForegroundColor Yellow",
        " }",
        "} else {",
        " $psi = [System.Diagnostics.ProcessStartInfo]::new($server)",
        " $psi.WorkingDirectory = $dir",
        " $psi.UseShellExecute = $true",
        " [System.Diagnostics.Process]::Start($psi) | Out-Null",
        " Start-Sleep -Seconds 3",
        " if (Get-Process -Name 'qingjian-server' -ErrorAction SilentlyContinue) {",
        "  Write-Host ' -> Qingjian Server started' -ForegroundColor Green",
        " } else {",
        "  Write-Host ' -> Exited immediately: 多半是 uiAccess 未获授予（不在 Program Files / 未签名）' -ForegroundColor Yellow",
        " }",
        "}",
        "",
        "Write-Host ''",
        "Write-Host 'Qingjian installation initialization completed.' -ForegroundColor Green",
        "Write-Host 'The Qingjian keyboard profile is now attached to zh-CN, and the server is configured for login startup.' -ForegroundColor Green"
    ],
    "pre_uninstall": [
        "$dll64 = \"$dir\\qingjian_tsf-$version.dll\"",
        "$dll32 = \"$dir\\qingjian_tsf-$version-x86.dll\"",
        "$reg32 = \"$env:SystemRoot\\SysWOW64\\regsvr32.exe\"",
        "$profileTip = '0804:{4FDCA82D-E923-49BF-9E75-BB906B93B8BB}{8119F8E0-CF81-423B-9189-C0D7374324B3}'",
        "",
        "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "function Unregister-Dll($path, $exe) {",
        " if (Test-Path $path) {",
        "  if ($isAdmin) { & $exe /u /s $path }",
        "  else { Start-Process $exe -ArgumentList '/u', '/s', $path -Verb RunAs -Wait }",
        " }",
        "}",
        "",
        "# 1. 停止 Qingjian 进程，避免 DLL/Server 保持活动状态。",
        "Write-Host '[1/5] Stopping Qingjian processes...' -ForegroundColor Cyan",
        "Stop-Process -Name 'qingjian-server' -Force -ErrorAction SilentlyContinue",
        "Stop-Process -Name 'qingjian-settings' -Force -ErrorAction SilentlyContinue",
        "",
        "# 2. 从当前用户的中文键盘列表移除青简 profile。",
        "Write-Host '[2/5] Removing Qingjian from the zh-CN keyboard list...' -ForegroundColor Cyan",
        "$langList = Get-WinUserLanguageList",
        "$zh = $langList | Where-Object { $_.LanguageTag -eq 'zh-CN' } | Select-Object -First 1",
        "$languageListChanged = $false",
        "if ($zh -and ($zh.InputMethodTips -contains $profileTip)) {",
        " $zh.InputMethodTips.Remove($profileTip)",
        " $languageListChanged = $true",
        "}",
        "if ($languageListChanged) { Set-WinUserLanguageList -LanguageList $langList -Force }",
        "",
        "# 3. 注销 TSF COM 组件。",
        "Write-Host '[3/5] Unregistering TSF components...' -ForegroundColor Cyan",
        "Unregister-Dll $dll64 'regsvr32.exe'",
        "Unregister-Dll $dll32 $reg32",
        "",
        "# 4. 刷新 TSF，并恢复运行状态。",
        "Write-Host '[4/5] Refreshing Windows Text Services...' -ForegroundColor Cyan",
        "Stop-Process -Name 'ctfmon' -Force -ErrorAction SilentlyContinue",
        "Start-Process 'ctfmon.exe'",
        "",
        "# 5. 清理持久自启动，包括本版本的 Startup 快捷方式和旧版 Run 项。",
        "Write-Host '[5/5] Cleaning up login startup...' -ForegroundColor Cyan",
        "$startupDir = [Environment]::GetFolderPath('Startup')",
        "Remove-Item -Path (Join-Path $startupDir 'Qingjian Server.lnk') -Force -ErrorAction SilentlyContinue",
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'QingjianServer' -Force -ErrorAction SilentlyContinue",
        "",
        "Write-Host 'Uninstallation preparation completed.' -ForegroundColor Green"
    ],
    "notes": [
        "Install from a NON-elevated PowerShell. The Inno Setup installer elevates itself (PrivilegesRequired=admin) and registers both TSF DLLs via its [Run] section; post_install must stay at the user's own integrity level, otherwise Windows refuses to create the uiAccess=true server process (ERROR_ELEVATION_REQUIRED 740).",
        "After installation the Qingjian keyboard profile is attached to zh-CN and the server is started once for the current session.",
        "Windows login startup keeps the Qingjian server running afterwards."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/qingjian-team/qingjian/releases",
        "regex": "tag_name\\s*:\\s*\"(?<version>windows-v(?>[\\d.]+(?:-[\\w.-]+)?))\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qingjian-team/qingjian/releases/download/$matchTag/qingjian-$version-windows-x86_64-setup.exe",
                "hash": {
                    "url": "https://github.com/qingjian-team/qingjian/releases/download/$matchTag/SHA256SUMS"
                }
            }
        }
    }
}
