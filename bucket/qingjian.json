{
    "version": "0.1.3",
    "description": "A Rust-based Chinese Pinyin input method with translation candidates for language learning.",
    "homepage": "https://qingjian.app",
    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/qingjian-team/qingjian/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/qingjian-team/qingjian/releases/download/windows-v0.1.3/qingjian-0.1.3-windows-x86_64-setup.exe",
            "hash": "257c3b4008b6f8f1aac0666100eab51fa6646e9ae49df51fbce58cbf3eefa52c"
        }
    },
    "installer": {
        "args": [
            "/DIR=\"$dir\"",
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART"
        ]
    },
    "post_install": [
        "$dll64 = \"$dir\\qingjian_tsf-$version.dll\"",
        "$dll32 = \"$dir\\qingjian_tsf-$version-x86.dll\"",
        "$reg32 = \"$env:SystemRoot\\SysWOW64\\regsvr32.exe\"",
        "",
        "# 1. 授予 UWP 应用容器加载权限",
        "Write-Host '[1/5] Granting AppContainer permissions for UWP apps...' -ForegroundColor Cyan",
        "& \"$env:SystemRoot\\System32\\icacls.exe\" $dir /grant \"*S-1-15-2-1:(OI)(CI)RX\" /T /C /Q | Out-Null",
        "",
        "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "function Register-Dll($path, $exe) {",
        "  if ($isAdmin) {",
        "    $p = Start-Process $exe -ArgumentList '/s', $path -Wait -PassThru -NoNewWindow",
        "    return $p.ExitCode",
        "  } else {",
        "    Write-Host \"Requesting Admin to register $(Split-Path $path -Leaf)...\" -ForegroundColor Yellow",
        "    $p = Start-Process $exe -ArgumentList '/s', $path -Verb RunAs -Wait -PassThru",
        "    return $p.ExitCode",
        "  }",
        "}",
        "",
        "# 2 & 3. 注册 TSF COM 组件",
        "Write-Host '[2/5] Registering 64-bit TSF component...' -ForegroundColor Cyan",
        "$code64 = Register-Dll $dll64 'regsvr32.exe'",
        "if ($code64 -eq 0) { Write-Host '  -> Registration Successful' -ForegroundColor Green } else { Write-Host \"  -> Registration Failed with code $code64\" -ForegroundColor Red }",
        "",
        "Write-Host '[3/5] Registering 32-bit TSF component...' -ForegroundColor Cyan",
        "$code32 = Register-Dll $dll32 $reg32",
        "if ($code32 -eq 0) { Write-Host '  -> Registration Successful' -ForegroundColor Green } else { Write-Host \"  -> Registration Failed with code $code32\" -ForegroundColor Red }",
        "",
        "# 4. 启动 Server (关键：使用 explorer.exe 强制降权到当前用户启动)",
        "Write-Host '[4/5] Starting Qingjian Server with user privileges...' -ForegroundColor Cyan",
        "Start-Process explorer.exe -ArgumentList \"`\"$dir\\qingjian-server.exe`\"\"",
        "",
        "# 5. 重启 ctfmon 刷新输入法缓存",
        "Write-Host '[5/5] Restarting ctfmon to refresh input method list...' -ForegroundColor Cyan",
        "Stop-Process -Name ctfmon -Force -ErrorAction SilentlyContinue",
        "Start-Process ctfmon.exe",
        "",
        "# 创建开机自启快捷方式",
        "$startupPath = \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\Qingjian Server.lnk\"",
        "if (!(Test-Path $startupPath)) {",
        "  $WshShell = New-Object -ComObject WScript.Shell",
        "  $Shortcut = $WshShell.CreateShortcut($startupPath)",
        "  $Shortcut.TargetPath = \"$dir\\qingjian-server.exe\"",
        "  $Shortcut.WorkingDirectory = \"$dir\"",
        "  $Shortcut.Save()",
        "}",
        "",
        "Write-Host ''",
        "Write-Host '=== IMPORTANT ===' -ForegroundColor Yellow",
        "Write-Host 'If this is your first time installing, Windows may require you to manually add \"Qingjian\"' -ForegroundColor Yellow",
        "Write-Host 'via: Settings -> Time & Language -> Language -> Chinese -> Options -> Add Keyboard.' -ForegroundColor Yellow",
        "Write-Host '=================' -ForegroundColor Yellow"
    ],
    "pre_uninstall": [
        "$dll64 = \"$dir\\qingjian_tsf-$version.dll\"",
        "$dll32 = \"$dir\\qingjian_tsf-$version-x86.dll\"",
        "$reg32 = \"$env:SystemRoot\\SysWOW64\\regsvr32.exe\"",
        "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "function Unregister-Dll($path, $exe) {",
        "  if (Test-Path $path) {",
        "    if ($isAdmin) { & $exe /u /s $path }",
        "    else { Start-Process $exe -ArgumentList '/u', '/s', $path -Verb RunAs -Wait }",
        "  }",
        "}",
        "",
        "# 1. 停止清简相关后台进程",
        "Write-Host '[1/4] Stopping Qingjian processes...' -ForegroundColor Cyan",
        "Stop-Process -Name 'qingjian-server' -Force -ErrorAction SilentlyContinue",
        "Stop-Process -Name 'qingjian-settings' -Force -ErrorAction SilentlyContinue",
        "",
        "# 2. 重启 Explorer 和 CTFMon 以解除 TSF DLL 的文件占用 (核心修复)",
        "Write-Host '[2/4] Restarting Explorer and CTFMon to release file locks...' -ForegroundColor Cyan",
        "Stop-Process -Name 'explorer' -Force -ErrorAction SilentlyContinue",
        "Stop-Process -Name 'ctfmon' -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Seconds 2",
        "",
        "# 3. 注销 TSF COM 组件",
        "Write-Host '[3/4] Unregistering TSF components...' -ForegroundColor Cyan",
        "Unregister-Dll $dll64 'regsvr32.exe'",
        "Unregister-Dll $dll32 $reg32",
        "",
        "# 4. 恢复 Explorer 和 CTFMon 并清理快捷方式",
        "Write-Host '[4/4] Restoring Explorer and CTFMon...' -ForegroundColor Cyan",
        "Start-Process 'explorer.exe'",
        "Start-Process 'ctfmon.exe'",
        "",
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\Qingjian Server.lnk\" -Force -ErrorAction SilentlyContinue",
        "",
        "Write-Host 'Uninstallation preparation completed.' -ForegroundColor Green"
    ],
    "notes": [
        "Administrator privileges are REQUIRED to install and uninstall this app.",
        "Please accept the UAC prompt during installation.",
        "If \"Qingjian\" does not appear in the language bar immediately, please add it manually via Windows Settings."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/qingjian-team/qingjian/releases",
        "regex": "\"tag_name\"\\s*:\\s*\"(?<tag>windows-v(?<version>[\\d.]+(?:-[\\w.-]+)?))\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qingjian-team/qingjian/releases/download/$matchTag/qingjian-$version-windows-x86_64-setup.exe",
                "hash": {
                    "url": "https://github.com/qingjian-team/qingjian/releases/download/$matchTag/SHA256SUMS"
                }
            }
        }
    }
}
