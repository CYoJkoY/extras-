{
    "version": "0.1.3",
    "description": "A Rust-based Chinese Pinyin input method with translation candidates for language learning.",
    "homepage": "https://qingjian.app",
    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/qingjian-team/qingjian/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/qingjian-team/qingjian/releases/download/windows-v0.1.3/qingjian-0.1.3-windows-x86_64-setup.exe",
            "hash": "257c3b4008b6f8f1aac0666100eab51fa6646e9ae49df51fbce58cbf3eefa52c"
        }
    },
    "installer": {
        "args": [
            "/DIR=\"$dir\"",
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART"
        ]
    },
    "post_install": [
        "$dll64 = \"$dir\\qingjian_tsf-$version.dll\"",
        "$dll32 = \"$dir\\qingjian_tsf-$version-x86.dll\"",
        "$reg32 = \"$env:SystemRoot\\SysWOW64\\regsvr32.exe\"",
        "",
        "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "function Register-Dll($path, $exe) {",
        "  & $exe /s $path",
        "  if ($LASTEXITCODE -ne 0) {",
        "    if (-not $isAdmin) { Write-Host \"Requesting administrator privileges to register $(Split-Path $path -Leaf)...\" -ForegroundColor Yellow }",
        "    Start-Process $exe -ArgumentList '/s', $path -Verb RunAs -Wait",
        "  }",
        "}",
        "Register-Dll $dll64 'regsvr32.exe'",
        "Register-Dll $dll32 $reg32",
        "",
        "# Start the server immediately (silent installer skips this)",
        "Start-Process \"$dir\\qingjian-server.exe\" -WorkingDirectory \"$dir\" -WindowStyle Hidden",
        "",
        "# Ensure user startup shortcut for auto-start on login",
        "$startupPath = \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\Qingjian Server.lnk\"",
        "if (!(Test-Path $startupPath)) {",
        "  $WshShell = New-Object -ComObject WScript.Shell",
        "  $Shortcut = $WshShell.CreateShortcut($startupPath)",
        "  $Shortcut.TargetPath = \"$dir\\qingjian-server.exe\"",
        "  $Shortcut.WorkingDirectory = \"$dir\"",
        "  $Shortcut.Save()",
        "}"
    ],
    "pre_uninstall": [
        "$dll64 = \"$dir\\qingjian_tsf-$version.dll\"",
        "$dll32 = \"$dir\\qingjian_tsf-$version-x86.dll\"",
        "$reg32 = \"$env:SystemRoot\\SysWOW64\\regsvr32.exe\"",
        "",
        "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "function Unregister-Dll($path, $exe) {",
        "  if (Test-Path $path) {",
        "    & $exe /u /s $path",
        "    if ($LASTEXITCODE -ne 0) {",
        "      if (-not $isAdmin) { Write-Host \"Requesting administrator privileges to unregister $(Split-Path $path -Leaf)...\" -ForegroundColor Yellow }",
        "      Start-Process $exe -ArgumentList '/u', '/s', $path -Verb RunAs -Wait",
        "    }",
        "  }",
        "}",
        "Unregister-Dll $dll64 'regsvr32.exe'",
        "Unregister-Dll $dll32 $reg32",
        "",
        "# Kill server and settings before uninstaller runs",
        "Stop-Process -Name 'qingjian-server' -Force -ErrorAction SilentlyContinue",
        "Stop-Process -Name 'qingjian-settings' -Force -ErrorAction SilentlyContinue",
        "",
        "# Remove user startup shortcut",
        "$startupPath = \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\Qingjian Server.lnk\"",
        "if (Test-Path $startupPath) {",
        "  Remove-Item $startupPath -Force",
        "}"
    ],
    "notes": [
        "Administrator privileges are REQUIRED to install and uninstall this app, as it must register a system-wide TSF COM component.",
        "If a UAC prompt appears during installation, please accept it to complete the registration.",
        "The server process (qingjian-server.exe) will be automatically started and added to your user Startup folder."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/qingjian-team/qingjian/releases",
        "regex": "\"tag_name\"\\s*:\\s*\"(?<tag>windows-v(?<version>[\\d.]+(?:-[\\w.-]+)?))\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qingjian-team/qingjian/releases/download/$matchTag/qingjian-$version-windows-x86_64-setup.exe",
                "hash": {
                    "url": "https://github.com/qingjian-team/qingjian/releases/download/$matchTag/SHA256SUMS"
                }
            }
        }
    }
}
