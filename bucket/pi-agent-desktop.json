{
  "version": "0.7.6",
  "description": "Pi - A cross-platform AI coding agent, bringing the Claude Code experience to your desktop. No environment setup, no terminal commands.",
  "homepage": "https://github.com/abcwyc/pi-agent-desktop",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/abcwyc/pi-agent-desktop/releases/download/v0.7.6/Pi.Agent_0.7.6_x64-setup.exe#/dl.7z",
      "hash": "99504f443a044596e9aac67efc17f3ef87e859b3f44f66c41b6507b2ca101212"
    }
  },
  "pre_install": [
    "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Force -Recurse",
    "# 提前在 pre_install 中生成 clean-cache.cmd，确保 Scoop 在创建 Shim 时文件已就绪",
    "$cleanerPath = \"$dir\\clean-cache.cmd\"",
    "$cmdLines = @(",
    "    '@echo off',",
    "    'echo [1/2] Terminating Pi Desktop process...',",
    "    'taskkill /F /IM pi-agent-desktop.exe >nul 2>&1',",
    "    'echo [2/2] Wiping temporary WebView2 and C-drive caches...',",
    "    'rd /s /q \"%APPDATA%\\pi-agent-desktop\\Cache\" >nul 2>&1',",
    "    'rd /s /q \"%APPDATA%\\pi-agent-desktop\\Code Cache\" >nul 2>&1',",
    "    'rd /s /q \"%LOCALAPPDATA%\\pi-agent-desktop\\EBWebView\" >nul 2>&1',",
    "    'echo [Done] Cache cleaned. Plugins and data in persist remain untouched!',",
    "    'timeout /t 2 >nul'",
    ")",
    "Set-Content -Path $cleanerPath -Value $cmdLines -Encoding ASCII"
  ],
  "post_install": [
    "# 1. 结束占用进程",
    "Stop-Process -Name 'pi-agent-desktop' -Force -ErrorAction SilentlyContinue",
    "Stop-Process -Name 'node' -ErrorAction SilentlyContinue",
    "",
    "# 2. 确保 Scoop 的 persist 真实物理目录准备就绪",
    "$targetDir = \"$persist_dir\\.pi\"",
    "if (!(Test-Path $targetDir)) { New-Item -ItemType Directory -Path $targetDir -Force | Out-Null }",
    "",
    "# 3. 迁移已有数据并创建软联接",
    "$linkPath = \"$env:USERPROFILE\\.pi\"",
    "if (Test-Path $linkPath) {",
    "    $isReparse = (Get-Item $linkPath -Force).Attributes -band [System.IO.FileAttributes]::ReparsePoint",
    "    if (!$isReparse) {",
    "        Get-ChildItem -Path $linkPath -Force | ForEach-Object {",
    "            Copy-Item -Path $_.FullName -Destination $targetDir -Recurse -Force",
    "        }",
    "        Remove-Item $linkPath -Recurse -Force",
    "    } else {",
    "        cmd.exe /c \"rmdir `\"$linkPath`\"\"",
    "    }",
    "}",
    "if (!(Test-Path $linkPath)) {",
    "    cmd.exe /c \"mklink /J `\"$linkPath`\" `\"$targetDir`\"\"",
    "}"
  ],
  "pre_uninstall": [
    "# 卸载时仅断开软链接，保护 persist 内的数据",
    "$linkPath = \"$env:USERPROFILE\\.pi\"",
    "if (Test-Path $linkPath) {",
    "    $isReparse = (Get-Item $linkPath -Force).Attributes -band [System.IO.FileAttributes]::ReparsePoint",
    "    if ($isReparse) { cmd.exe /c \"rmdir `\"$linkPath`\"\" }",
    "}"
  ],
  "bin": [
    "pi-agent-desktop.exe",
    "clean-cache.cmd"
  ],
  "shortcuts": [
    [
      "pi-agent-desktop.exe",
      "Pi Agent"
    ],
    [
      "clean-cache.cmd",
      "Pi Agent - Clear Cache"
    ]
  ],
  "checkver": {
    "github": "https://github.com/abcwyc/pi-agent-desktop",
    "regex": "(?:/releases/tag/|^)v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/abcwyc/pi-agent-desktop/releases/download/v$version/Pi.Agent_$version_x64-setup.exe#/dl.7z"
      }
    }
  }
}
